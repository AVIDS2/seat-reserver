PLATFORM_PUBLIC_URL=https://seat.rglens.com
PLATFORM_WEB_PORT=3200
PLATFORM_API_PORT=3201

PLATFORM_DB_NAME=seat_platform
PLATFORM_DB_USER=seat_platform
PLATFORM_DB_PASSWORD=replace-with-a-long-random-password

PLATFORM_AUTH_JWT_SECRET=replace-with-a-long-random-secret
PLATFORM_AUTH_REFRESH_SECRET=replace-with-a-long-random-secret
PLATFORM_AUTH_FORGOT_SECRET=replace-with-a-long-random-secret
PLATFORM_AUTH_CONFIRM_SECRET=replace-with-a-long-random-secret
PLATFORM_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-random-secret

# Optional: leave empty to create the first admin from the sign-up page.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Product rewards policy. Pro is permanent and priced at CNY 20; Pro activation
# is confirmed manually by an administrator until a payment provider is wired.
PLATFORM_INVITE_POINTS_COST=600
PLATFORM_INVITE_VALID_DAYS=30
PLATFORM_DAILY_ACTIVITY_POINTS=30
PLATFORM_REFERRAL_REWARD_POINTS=50

# Optional Stripe one-time Checkout for the ¥20 permanent Pro plan.
# Leave empty to keep the administrator-confirmed application flow.
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=
PLATFORM_STRIPE_PRICE_ID=

# Optional AI assistant provider for 席定领航. OpenAI-compatible Chat Completions.
# PLATFORM_AI_* takes precedence; when empty, the assistant can reuse the VLM provider below.
PLATFORM_AI_BASE_URL=
PLATFORM_AI_API_KEY=
PLATFORM_AI_MODEL=

SEAT_API_URL=https://leosys.cn/cczukaoyan/rest/v2/freeBook
SEAT_AUTH_URL=https://leosys.cn/cczukaoyan/rest/auth
SEAT_USER_URL=https://leosys.cn/cczukaoyan/rest/v2/user
SEAT_HMAC_REQUEST_KEY=
SEAT_WEBVPN_URL=https://zmvpn.cczu.edu.cn
SEAT_WEBVPN_APP_NAME=图书馆座位预约
SEAT_WEBVPN_APP_PATH=/libseat/
SEAT_WEBVPN_TARGET_URL=http://202.195.100.14
LIBRARY_WEBVPN_TARGET_URL=http://zuowei.cczu.edu.cn
SEAT_WEBVPN_TIMEOUT_MS=15000
SEAT_WEBVPN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/132.0.0.0 Safari/537.36
SEAT_REFERER=https://servicewechat.com/wxd0a21b477b3ac4f2/59/page-frame.html
SEAT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36 MicroMessenger/7.0.20.1781(0x6700143B) NetType/WIFI MiniProgramEnv/Windows WindowsWechat/WMPF WindowsWechat(0x63090a13) UnifiedPCWindowsWechat(0xf2541b37) XWEB/20089

# Vision model for solving the school's point-and-click captcha server-side.
# Any OpenAI-compatible endpoint works. Xiaomi MiMo is the verified default:
# only `mimo-v2.5` accepts images (`mimo-v2.5-pro` is text only), and the
# platform already disables its thinking mode via the `mimo` preset.
PLATFORM_VLM_BASE_URL=https://api.xiaomimimo.com/v1
PLATFORM_VLM_API_KEY=
PLATFORM_VLM_MODEL=mimo-v2.5
# auto | normalized (0-1000 coords) | pixel
PLATFORM_VLM_COORD_MODE=auto
PLATFORM_VLM_TIMEOUT_MS=30000

# Optional: fail over between several providers. Use either the comma-separated
# preset list (mimo, qwen, deepseek, glm, openai) or the JSON form for anything
# else. The presets carry each vendor's base URL, model and coordinate mode.
# PLATFORM_VLM_PROVIDERS=mimo,qwen
# PLATFORM_VLM_QWEN_API_KEY=
# PLATFORM_VLM_PROVIDERS_JSON=[{"name":"vendor","baseUrl":"https://example.com/v1","apiKey":"...","model":"..."}]

# Set to false to stop scheduling library auto-booking tasks entirely.
PLATFORM_LIBRARY_AUTO_BOOKING=true

